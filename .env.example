# platform-agent-adaptor 环境配置（HTTP only，不包含飞书）

# ---------- HTTP API ----------
ADAPTOR_API_ENABLED=true
ADAPTOR_API_HOST=127.0.0.1
ADAPTOR_API_PORT=8091
# 与平台 ISSUE_MASTER_TOKEN / AGENT_ADAPTOR_TOKEN 保持一致
ADAPTOR_API_TOKEN=
ADAPTOR_API_TLS_CERT=
ADAPTOR_API_TLS_KEY=
ADAPTOR_API_RATE_LIMIT=30

# ---------- GitHub（机器人身份）----------
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
GITHUB_BOT_TOKEN=
GITHUB_REPOS=AISBench/benchmark
GITHUB_DEFAULT_REPO=AISBench/benchmark
GITHUB_API_BASE=https://api.github.com

# ---------- issue 巡检参数（引擎保留）----------
ISSUE_DIGEST_DAYS=1
ISSUE_DIGEST_SCHEDULE=off
ISSUE_STALL_DAYS=7

# ---------- 知识库（deepwiki-open）----------
KB_BACKEND=deepwiki_open
KB_BASE_URL=http://127.0.0.1:8001
KB_PROVIDER=openai
KB_MODEL=
KB_LANGUAGE=zh
KB_TIMEOUT=600
KB_REFRESH_ENABLED=true
KB_REFRESH_SCHEDULE=03:00
KB_BACKUP_ENABLED=true
KB_BACKUP_SCHEDULE=03:30
KB_BACKUP_KEEP=7
KB_BACKUP_DIR=./data/kb_backup
KB_BACKUP_MIN_FREE_GB=5
KB_HISTORY_TURNS=6
KB_DATA_DIR=./data/deepwiki_open

# ---------- Agent / LLM ----------
AGENT_BACKEND=pydantic_ai
AGENT_FALLBACK=echo
AGENT_TOOLS_ENABLED=true
AGENT_MAX_TURNS=8
AGENT_MCP_SERVERS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=600

# ---------- 本服务 ----------
FERNET_KEY=
DB_PATH=./data/agent-adaptor.db
QUEUE_WORKERS=2
CA_BUNDLE=
